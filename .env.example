# Supabase — the public tunnel URL, reachable from Vercel
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com

# Service role key. Server-side only. Never referenced in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for this console. Change it before deploying.
ADMIN_PASSWORD=

# Any long random string. Signs the session cookie.
SESSION_SECRET=

# Store portal (anon key + user session). Whole /store area depends on it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# n8n webhook that sends a store owner's tagged answer to the customer.
ARPHA_N8N_REPLY_WEBHOOK=

# Shared secret checked by n8n before sending (x-arpha-secret header).
ARPHA_N8N_WEBHOOK_SECRET=

# Cookie name of the existing admin console session, if different from arpha_session.
ADMIN_SESSION_COOKIE=
