# ────────────────────────────────────────────────────────────────
# Arpha — Supabase configuration
# Copy to `.env.local` (development) or configure in your host.
# ────────────────────────────────────────────────────────────────

# Public project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key (safe to expose to the browser; RLS must enforce access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose to the browser.
# Required for privileged operations (admin, migrations fallbacks, webhooks).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Telegram bot token used by the bot side of the platform.
# Not read directly by the dashboard in V1; reserved for future use.
# TELEGRAM_BOT_TOKEN=

# Optional: LiteLLM base URL + key used by AI features (reserved for V2).
# LITELLM_BASE_URL=
# LITELLM_API_KEY=
