# Supabase — the public tunnel URL, reachable from Vercel
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com

# Service role key. Server-side only. Never referenced in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for this console. Change it before deploying.
ADMIN_PASSWORD=

# Any long random string. Signs the session cookie.
SESSION_SECRET=
